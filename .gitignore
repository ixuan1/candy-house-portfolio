# ============================================================
#  糖果屋 · Git 忽略规则
#  核心原则：含密码的 .env 绝不进仓库；本地环境产物不进仓库。
# ============================================================

# ---------- 敏感配置（绝不提交）----------
# api/.env 含数据库/生产密码，仅在服务器本地配置。
# 注意：*.env 只匹配以 .env 结尾的文件，不会误伤 .env.example（示例模板需留仓库）。
*.env
api/.env

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 系统 / IDE ----------
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---------- 日志 ----------
*.log

# ---------- Docker 本地产物（如有）----------
docker/data/

# ---------- 测试 / 缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
