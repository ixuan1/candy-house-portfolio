# 复制为 .env 后填入真实值（不要提交真实 .env 到 git）
#
# 🔑 这份 .env 是“密码唯一来源”：docker-compose.yml 里的 db 和 app
#    两个服务都通过 env_file 读取它。所以下面所有密码必须一致、且都要改成强密码。
#    Docker 内 app 通过服务名 db 访问 MySQL。
MYSQL_HOST=db
MYSQL_PORT=3306

# —— 账号密码（db 建库/建用户 与 app 连库 都用这一份）——
MYSQL_USER=candy
MYSQL_PASSWORD=change_me_strong
MYSQL_ROOT_PASSWORD=root_strong_please_change
MYSQL_DATABASE=candy_house

# SQLAlchemy 连接串：mysql+pymysql://用户:密码@主机:端口/库名
# ⚠️ 里面的密码要和上面的 MYSQL_PASSWORD 保持一致！
DATABASE_URL=mysql+pymysql://candy:change_me_strong@db:3306/candy_house
